# ==============================================================================
# Central Office Command Center - Environment Configuration
# ==============================================================================

# Server & Network
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/command_center
DB_CLIENT=pg
USE_IN_MEMORY_DB=false

# Redis (Redis 7)
REDIS_URL=redis://localhost:6379
USE_MOCK_REDIS=false

# Seed Account Passwords (Required for db:seed, never written in code or README)
SEED_ADMIN_PASSWORD=
SEED_COADMIN_PASSWORD=
SEED_CORE_PASSWORD=
SEED_INTERN_PASSWORD=

# RS256 JWT Authentication Keys (Read from environment variables or key paths)
# Generate with: node scripts/generate-jwt-keys.mjs
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
TOKEN_ENCRYPTION_SECRET=

# Nodemailer SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web-Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Google Calendar OAuth 2.0 (Optional, off unless configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/google/callback

# Microsoft SSO (Optional, off unless configured)
MS_OIDC_CLIENT_ID=
MS_OIDC_CLIENT_SECRET=
MS_OIDC_TENANT_ID=common
MS_OIDC_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
